{
  "name": "visualizer-studio",
  "private": true,
  "version": "0.1.0",
  "description": "AE-style layer/keyframe/curve editor for building Spectralis capsule audio visualizers.",
  "author": "DeltaVDevs",
  "type": "module",
  "main": "electron-out/main.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "electron:compile": "tsc -p electron/tsconfig.json && node -e \"require('fs').writeFileSync('electron-out/package.json', JSON.stringify({type:'commonjs'}))\"",
    "electron:dev": "npm run electron:compile && concurrently -k -s first \"vite\" \"wait-on tcp:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "electron:build": "npm run build && npm run electron:compile && electron-builder",
    "electron:build:win": "npm run electron:build -- --win",
    "electron:build:linux": "npm run electron:build -- --linux",
    "electron:build:mac": "npm run electron:build -- --mac"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.1.1",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^26.4.0",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "dockview-core": "^3.2.0",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "jsdom": "^25.0.1",
    "svelte": "^5.1.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^6.4.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.7",
    "wait-on": "^9.1.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.34.0"
  }
}
