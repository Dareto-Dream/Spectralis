<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="Wasmtime" Version="44.0.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="coverlet.collector" Version="6.0.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Spectralis.Core\Spectralis.Core.csproj" />
    <ProjectReference Include="..\Spectralis.App\Spectralis.App.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Fixtures\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Same wgpu-host native library the app build produces (see Spectralis.App.csproj's
       BuildWgpuHost target) — needed here so WgpuWorldRendererTests can P/Invoke it directly. -->
  <Target Name="BuildWgpuHost" BeforeTargets="Build" Condition="Exists('..\wgpu-host\Cargo.toml')">
    <Exec Command="cargo build --release --manifest-path &quot;$(MSBuildProjectDirectory)\..\wgpu-host\Cargo.toml&quot;" ContinueOnError="true" />
  </Target>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <Content Include="..\wgpu-host\target\release\wgpu_host.dll" Link="wgpu_host.dll" Condition="Exists('..\wgpu-host\target\release\wgpu_host.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <Content Include="..\wgpu-host\target\release\libwgpu_host.so" Link="libwgpu_host.so" Condition="Exists('..\wgpu-host\target\release\libwgpu_host.so')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <Content Include="..\wgpu-host\target\release\libwgpu_host.dylib" Link="libwgpu_host.dylib" Condition="Exists('..\wgpu-host\target\release\libwgpu_host.dylib')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
