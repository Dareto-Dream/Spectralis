# Discord application credentials (https://discord.com/developers/applications)
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Base URL of the Spectralis backend that hosts the Streamer Queue API
# (same value as SqCdnBaseUrl in the desktop app's settings).
SQ_API_BASE_URL=https://audioplayer-production-5b83.up.railway.app

# Where the bot's local SQLite database (guild<->room links) is written.
DB_PATH=./data/bot.sqlite3
