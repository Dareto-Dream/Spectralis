<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Spectralis.App.ViewModels"
        x:Class="Spectralis.App.Views.PlaylistPickerWindow"
        Title="Add to Playlist"
        Icon="/Assets/icon.png"
        Width="360" Height="420"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Brush.Bg.Base}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="20" RowSpacing="12">
    <TextBlock Grid.Row="0" Classes="secondary" Text="Choose a playlist:" />

    <ListBox x:Name="PlaylistList" Grid.Row="1"
             DoubleTapped="OnListDoubleTapped">
      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:PlaylistRow">
          <TextBlock Text="{Binding DisplayName}" />
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Add" Click="OnAdd" IsDefault="True" Classes="primary" />
      <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
    </StackPanel>
  </Grid>
</Window>
