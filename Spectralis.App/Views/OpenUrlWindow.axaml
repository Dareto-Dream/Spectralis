<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Spectralis.App.Views.OpenUrlWindow"
        Title="Open URL"
        Width="520" Height="224"
        MinWidth="420" MinHeight="224"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/icon.png"
        Background="{StaticResource Brush.Bg.Base}">

  <StackPanel Margin="20" Spacing="12">
    <TextBlock Classes="heading" Text="Open URL" />
    <TextBox x:Name="UrlTextBox"
             Watermark="Paste a track or playlist link…"
             KeyDown="OnUrlTextBoxKeyDown" />
    <TextBlock Text="SPOTIFY · SOUNDCLOUD · BANDLAB · YOUTUBE · SUNO · UNTITLED · direct audio"
               Classes="data"
               Foreground="{StaticResource Brush.Ink.Muted}"
               FontSize="10"
               LetterSpacing="1.5"
               TextWrapping="Wrap" />
    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="OnCancelClick" MinWidth="88" />
      <Button Classes="primary" Content="Open" Click="OnOpenClick" MinWidth="88" />
    </StackPanel>
  </StackPanel>
</Window>
