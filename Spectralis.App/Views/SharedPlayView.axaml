<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectralis.App.ViewModels"
             x:Class="Spectralis.App.Views.SharedPlayView"
             x:DataType="vm:SharedPlayViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12" MaxWidth="560">

      <TextBlock Classes="display" Text="Shared Play" />
      <TextBlock Classes="secondary"
                 Text="Host a room so others can follow along in their browser in sync." />

      <StackPanel IsVisible="{Binding IsJoined}" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="data" Text="{Binding JoinedStatusText}" />
        </StackPanel>
        <TextBlock Classes="secondary" Text="You're listening along with someone else's room." />
        <Button Content="Leave" Command="{Binding LeaveJoinCommand}" Classes="destructive" HorizontalAlignment="Left" />
      </StackPanel>

      <StackPanel IsVisible="{Binding !IsJoined}" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="data" Text="{Binding StatusText}" />
          <TextBlock Classes="data secondary" Text="{Binding ListenerCount, StringFormat='· {0} listening'}"
                     IsVisible="{Binding IsHosting}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Host Room" Command="{Binding HostCommand}" Classes="primary"
                  IsVisible="{Binding !IsHosting}" IsEnabled="{Binding !HostPending}"
                  ToolTip.Tip="Starts as soon as you begin playing a track" />
          <Button Content="Stop Hosting" Command="{Binding StopCommand}" Classes="destructive" IsVisible="{Binding IsHosting}" />
          <Button Content="{Binding CopyLinkLabel}" Command="{Binding CopyLinkCommand}" IsVisible="{Binding IsHosting}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsHosting}" Spacing="4">
          <TextBlock Classes="secondary" Text="Join URL" />
          <TextBox Text="{Binding JoinUrl}" IsReadOnly="True" />
        </StackPanel>
      </StackPanel>

      <TextBlock Classes="data" FontSize="20" Text="{Binding RecentReactionsText}"
                 IsVisible="{Binding RecentReactionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <TextBlock Classes="error" Text="{Binding LastError}"
                 IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <StackPanel IsVisible="{Binding RequestedTracks.Count, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="6">
        <Separator Margin="0,4" />
        <TextBlock Classes="heading" Text="Requested by listeners" />
        <ItemsControl ItemsSource="{Binding RequestedTracks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SharedPlayRequestedTrackVm">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3,0,3">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" />
                  <TextBlock Classes="secondary" Text="{Binding Artist}"
                             IsVisible="{Binding Artist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Play" Command="{Binding PlayCommand}"
                        Classes="secondary" Margin="0,0,4,0" />
                <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}"
                        Classes="destructive" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Separator Margin="0,8" />

      <TextBlock Classes="heading" Text="Connection" />
      <CheckBox Content="Enable Shared Play" IsChecked="{Binding SharedPlayEnabled}" />
      <TextBlock Classes="secondary" Text="CDN base URL (optional)" />
      <TextBox Text="{Binding CdnBaseUrl}" Watermark="Leave blank for default CDN" />

      <Separator Margin="0,8" />

      <TextBlock Classes="heading" Text="Live Channel" />
      <CheckBox Content="Enable Live Channel" IsChecked="{Binding LiveChannelEnabled}" />
      <TextBlock Classes="secondary" Text="Channel ID" />
      <TextBox Text="{Binding LiveChannelId}" />
      <TextBlock Classes="secondary" Text="Owner token" />
      <TextBox Text="{Binding LiveChannelOwnerToken}" PasswordChar="•" />
      <TextBlock Classes="secondary" Text="Display name" />
      <TextBox Text="{Binding LiveChannelDisplayName}" Watermark="Spectralis Listener" />

    </StackPanel>
  </ScrollViewer>

</UserControl>
