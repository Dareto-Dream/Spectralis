<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectralis.App.ViewModels"
             x:Class="Spectralis.App.Views.SharedPlayView"
             x:DataType="vm:SharedPlayViewModel">

  <ScrollViewer>
    <StackPanel Margin="24" Spacing="12" MaxWidth="560">

      <TextBlock Classes="display" Text="Shared Play" />
      <TextBlock Classes="secondary"
                 Text="Listen together. Start a private party, or broadcast through your channel." />

      <Border Classes="card" Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Classes="heading" Text="Your Ward account" />
          <TextBlock Classes="secondary" Text="{Binding AccountStatus}" TextWrapping="Wrap" />
          <Button Content="Connect Ward" Command="{Binding ConnectWardCommand}" IsVisible="{Binding !WardConnected}" IsEnabled="{Binding !AccountBusy}" HorizontalAlignment="Left" />
          <Button Content="Disconnect" Command="{Binding DisconnectWardCommand}" IsVisible="{Binding WardConnected}" HorizontalAlignment="Left" />
          <TextBlock Classes="secondary" Text="Optional for private parties. Required for a persistent channel." TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel IsVisible="{Binding IsJoined}" Spacing="8">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="data" Text="{Binding JoinedStatusText}" />
          <Border Background="#22A882F2" CornerRadius="10" Padding="8,2">
            <TextBlock Classes="secondary" Text="{Binding JoinedRoleLabel}" />
          </Border>
        </StackPanel>
        <TextBlock Classes="secondary" Text="You're listening along with someone else's room." />
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding JoinedCanControl}">
          <Button Content="Play / Pause" Command="{Binding JoinPlayPauseCommand}" Classes="secondary" />
          <Button Content="Skip" Command="{Binding JoinNextCommand}" Classes="secondary" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !JoinedCanControl}">
          <Button Content="Vote skip" Command="{Binding JoinVoteSkipCommand}" Classes="secondary" />
          <TextBlock Classes="data" Text="{Binding JoinedSkipText}" VerticalAlignment="Center" />
        </StackPanel>
        <Button Content="Leave" Command="{Binding LeaveJoinCommand}" Classes="destructive" HorizontalAlignment="Left" />
      </StackPanel>

      <StackPanel IsVisible="{Binding !IsJoined}" Spacing="12">
        <StackPanel Orientation="Horizontal" Spacing="10">
          <TextBlock Classes="data" Text="{Binding StatusText}" />
          <TextBlock Classes="data secondary" Text="{Binding ListenerCount, StringFormat='· {0} listening'}"
                     IsVisible="{Binding IsHosting}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Start listening party" Command="{Binding HostCommand}" Classes="primary"
                  IsVisible="{Binding !IsHosting}" IsEnabled="{Binding !HostPending}"
                  ToolTip.Tip="Starts as soon as you begin playing a track" />
          <Button Content="Stop Hosting" Command="{Binding StopCommand}" Classes="destructive" IsVisible="{Binding IsHosting}" />
          <Button Content="{Binding CopyLinkLabel}" Command="{Binding CopyLinkCommand}" IsVisible="{Binding IsHosting}" />
        </StackPanel>

        <StackPanel IsVisible="{Binding IsHosting}" Spacing="4">
          <TextBlock Classes="secondary" Text="Join URL" />
          <TextBox Text="{Binding JoinUrl}" IsReadOnly="True" />
        </StackPanel>
      </StackPanel>

      <TextBlock Classes="data" FontSize="20" Text="{Binding RecentReactionsText}"
                 IsVisible="{Binding RecentReactionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <TextBlock Classes="error" Text="{Binding LastError}"
                 IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Collaborative room controls (host) -->
      <StackPanel IsVisible="{Binding IsHosting}" Spacing="8">
        <Separator Margin="0,4" />
        <TextBlock Classes="heading" Text="Room controls" />
        <TextBlock Classes="secondary"
                   Text="What everyone in the room can do. Promote individuals to Co-DJ for full control." />
        <CheckBox Content="Anyone can add to the queue" IsChecked="{Binding ListenersCanQueue}" />
        <CheckBox Content="Anyone can reorder the queue" IsChecked="{Binding ListenersCanReorder}" />
        <CheckBox Content="Anyone can remove tracks" IsChecked="{Binding ListenersCanRemove}" />
        <CheckBox Content="Anyone can control playback (play / pause / seek / skip)"
                  IsChecked="{Binding ListenersCanControlPlayback}" />
        <StackPanel Orientation="Horizontal" Spacing="10">
          <CheckBox Content="Vote-skip" IsChecked="{Binding VoteSkipEnabled}" VerticalAlignment="Center" />
          <TextBlock Text="votes needed" Classes="secondary" VerticalAlignment="Center" />
          <NumericUpDown Value="{Binding SkipVotesRequired}" Minimum="1" Maximum="20" Increment="1"
                         Width="90" FormatString="0" />
        </StackPanel>
        <TextBlock Classes="data" Text="{Binding SkipProgressText}"
                   IsVisible="{Binding SkipProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <TextBlock Classes="heading" Text="Listeners" Margin="0,6,0,0" />
        <ItemsControl ItemsSource="{Binding Members}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SharedPlayMemberVm">
              <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,3,0,3">
                <StackPanel>
                  <TextBlock Text="{Binding Name}" />
                  <TextBlock Classes="secondary" Text="{Binding RoleLabel}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Make Co-DJ" Command="{Binding PromoteCommand}"
                        Classes="secondary" Margin="0,0,4,0" IsVisible="{Binding CanPromote}" />
                <Button Grid.Column="2" Content="Demote" Command="{Binding DemoteCommand}"
                        Classes="secondary" Margin="0,0,4,0" IsVisible="{Binding CanDemote}" />
                <Button Grid.Column="3" Content="Kick" Command="{Binding KickCommand}"
                        Classes="destructive" IsVisible="{Binding !IsHost}" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Classes="heading" Text="Activity" Margin="0,6,0,0"
                   IsVisible="{Binding ActivityLog.Count}" />
        <ItemsControl ItemsSource="{Binding ActivityLog}" MaxHeight="140">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <TextBlock Classes="secondary" FontSize="12" Text="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <StackPanel IsVisible="{Binding RequestedTracks.Count, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="6">
        <Separator Margin="0,4" />
        <TextBlock Classes="heading" Text="Requested by listeners" />
        <ItemsControl ItemsSource="{Binding RequestedTracks}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:SharedPlayRequestedTrackVm">
              <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,3,0,3">
                <StackPanel>
                  <TextBlock Text="{Binding Title}" />
                  <TextBlock Classes="secondary" Text="{Binding Artist}"
                             IsVisible="{Binding Artist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
                <Button Grid.Column="1" Content="Play" Command="{Binding PlayCommand}"
                        Classes="secondary" Margin="0,0,4,0" />
                <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}"
                        Classes="destructive" />
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <Separator Margin="0,8" />

      <StackPanel Spacing="8" IsVisible="{Binding WardConnected}">
        <TextBlock Classes="heading" Text="Your channel" />
        <TextBlock Classes="secondary" Text="One permanent address, even between listening sessions." />
        <ComboBox ItemsSource="{Binding OwnedRooms}" SelectedItem="{Binding SelectedRoom}" HorizontalAlignment="Stretch" />
        <WrapPanel Orientation="Horizontal">
          <Button Content="New channel" Command="{Binding CreateChannelCommand}" Margin="0,0,8,8" />
          <Button Content="Refresh" Command="{Binding RefreshRoomsCommand}" Margin="0,0,8,8" />
          <Button Content="Branding &amp; access" Command="{Binding ManageRoomCommand}" Margin="0,0,8,8" />
          <Button Content="{Binding VisibilityLabel}" Command="{Binding TogglePublicCommand}" Margin="0,0,8,8" />
        </WrapPanel>
        <CheckBox Content="Broadcast this listening party through my channel" IsChecked="{Binding LiveChannelEnabled}" />
      </StackPanel>
      <Expander Header="Advanced connection settings">
        <StackPanel Spacing="8">
          <TextBlock Classes="secondary" Text="Custom backend URL. Leave empty for Spectralis." />
          <TextBox Text="{Binding CdnBaseUrl}" Watermark="Default backend" />
        </StackPanel>
      </Expander>

    </StackPanel>
  </ScrollViewer>

</UserControl>
