<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectralis.App.ViewModels"
             x:Class="Spectralis.App.Views.SharedPlayView"
             x:DataType="vm:SharedPlayViewModel">

  <UserControl.Styles>
    <!-- Section headers read left to right, like everything else on this screen. -->
    <Style Selector="Expander /template/ ToggleButton">
      <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="8" MaxWidth="520" HorizontalAlignment="Left">

      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Classes="heading" Text="Shared Play" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <TextBlock Classes="data" Text="{Binding StatusText}" IsVisible="{Binding !IsJoined}" />
          <TextBlock Classes="data secondary" Text="{Binding ListenerCount, StringFormat='· {0} listening'}" IsVisible="{Binding IsHosting}" />
        </StackPanel>
      </Grid>

      <!-- Listening along with someone else's room -->
      <Border Classes="card" Padding="12" IsVisible="{Binding IsJoined}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="data" Text="{Binding JoinedStatusText}" VerticalAlignment="Center" />
            <Border Grid.Column="1" Background="#22A882F2" CornerRadius="10" Padding="8,2">
              <TextBlock Classes="secondary" Text="{Binding JoinedRoleLabel}" />
            </Border>
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Play / Pause" Command="{Binding JoinPlayPauseCommand}" Classes="secondary" IsVisible="{Binding JoinedCanControl}" />
            <Button Content="Skip" Command="{Binding JoinNextCommand}" Classes="secondary" IsVisible="{Binding JoinedCanControl}" />
            <Button Content="Vote skip" Command="{Binding JoinVoteSkipCommand}" Classes="secondary" IsVisible="{Binding !JoinedCanControl}" />
            <TextBlock Classes="data" Text="{Binding JoinedSkipText}" VerticalAlignment="Center" IsVisible="{Binding !JoinedCanControl}" />
            <Button Content="Leave" Command="{Binding LeaveJoinCommand}" Classes="destructive" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Your own room: temporary when signed out, permanent when signed in -->
      <Border Classes="card" Padding="12" IsVisible="{Binding !IsJoined}">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Classes="heading" Text="{Binding ModeTitle}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding HasRoom}">
              <TextBlock Classes="secondary" Text="{Binding RoomName}" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <TextBlock Classes="secondary" Text="{Binding ModeText}" TextWrapping="Wrap" />

          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Start" Command="{Binding HostCommand}" Classes="primary"
                    IsVisible="{Binding !IsHosting}" IsEnabled="{Binding !HostPending}"
                    ToolTip.Tip="Goes live as soon as you start playing a track" />
            <Button Content="Stop" Command="{Binding StopCommand}" Classes="destructive" IsVisible="{Binding IsHosting}" />
            <Button Content="{Binding CopyLinkLabel}" Command="{Binding CopyLinkCommand}" IsVisible="{Binding IsHosting}" />
            <Button Content="Copy room link" Command="{Binding CopyRoomLinkCommand}" IsVisible="{Binding CanCopyRoomLink}" />
            <ToggleSwitch IsChecked="{Binding IsRoomPublic}" IsVisible="{Binding HasRoom}"
                          OnContent="Listed in the room finder" OffContent="Not listed" VerticalAlignment="Center" />
          </StackPanel>

          <TextBox Text="{Binding ShareLink}" IsReadOnly="True"
                   IsVisible="{Binding ShareLink, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <Separator />

          <!-- Account -->
          <Grid ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="secondary" VerticalAlignment="Center" Text="Not signed in" IsVisible="{Binding !WardConnected}" />
            <TextBlock Classes="secondary" VerticalAlignment="Center" Text="{Binding WardName, StringFormat='Signed in as {0}'}" IsVisible="{Binding WardConnected}" />
            <Button Grid.Column="1" Content="Sign in with Ward" Command="{Binding ConnectWardCommand}" IsEnabled="{Binding !AccountBusy}"
                    IsVisible="{Binding !WardConnected}" Margin="8,0,0,0" />
            <Button Grid.Column="1" Content="Room settings" Command="{Binding ManageRoomCommand}"
                    IsVisible="{Binding HasRoom}" Margin="8,0,0,0" />
            <Button Grid.Column="2" Content="Sign out" Command="{Binding DisconnectWardCommand}"
                    IsVisible="{Binding WardConnected}" Margin="8,0,0,0" />
          </Grid>
          <TextBlock Classes="error" Text="{Binding AccountStatus}" TextWrapping="Wrap"
                     IsVisible="{Binding AccountStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <TextBlock Classes="data" FontSize="20" Text="{Binding RecentReactionsText}"
                 IsVisible="{Binding RecentReactionsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <TextBlock Classes="error" Text="{Binding LastError}" TextWrapping="Wrap"
                 IsVisible="{Binding LastError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Host controls, folded away until needed -->
      <StackPanel IsVisible="{Binding IsHosting}" Spacing="4">
        <Expander Header="What listeners can do" HorizontalContentAlignment="Left">
          <StackPanel Spacing="2" Margin="0,4,0,0">
            <CheckBox Content="Add to the queue" IsChecked="{Binding ListenersCanQueue}" />
            <CheckBox Content="Reorder the queue" IsChecked="{Binding ListenersCanReorder}" />
            <CheckBox Content="Remove tracks" IsChecked="{Binding ListenersCanRemove}" />
            <CheckBox Content="Control playback (play, pause, seek, skip)" IsChecked="{Binding ListenersCanControlPlayback}" />
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CheckBox Content="Vote-skip after" IsChecked="{Binding VoteSkipEnabled}" VerticalAlignment="Center" />
              <NumericUpDown Value="{Binding SkipVotesRequired}" Minimum="1" Maximum="20" Increment="1" Width="90" FormatString="0" />
              <TextBlock Text="votes" Classes="secondary" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Classes="data" Text="{Binding SkipProgressText}"
                       IsVisible="{Binding SkipProgressText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <TextBlock Classes="secondary" Text="Make someone a Co-DJ from the listener list for full control." />
          </StackPanel>
        </Expander>

        <Expander Header="{Binding Members.Count, StringFormat='Listeners ({0})'}" HorizontalContentAlignment="Left">
          <ItemsControl ItemsSource="{Binding Members}" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SharedPlayMemberVm">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto" Margin="0,2">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" />
                    <TextBlock Classes="secondary" Text="{Binding RoleLabel}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Co-DJ" Command="{Binding PromoteCommand}"
                          Classes="secondary" Margin="0,0,4,0" IsVisible="{Binding CanPromote}" />
                  <Button Grid.Column="2" Content="Demote" Command="{Binding DemoteCommand}"
                          Classes="secondary" Margin="0,0,4,0" IsVisible="{Binding CanDemote}" />
                  <Button Grid.Column="3" Content="Kick" Command="{Binding KickCommand}"
                          Classes="destructive" IsVisible="{Binding !IsHost}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>

        <Expander Header="Activity" HorizontalContentAlignment="Left" IsVisible="{Binding ActivityLog.Count}">
          <ItemsControl ItemsSource="{Binding ActivityLog}" MaxHeight="140" Margin="0,4,0,0">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Classes="secondary" FontSize="12" Text="{Binding}" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </StackPanel>

      <Border Classes="card" Padding="12" IsVisible="{Binding HasRequests}">
        <StackPanel Spacing="4">
          <TextBlock Classes="heading" Text="Requested by listeners" />
          <ItemsControl ItemsSource="{Binding RequestedTracks}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:SharedPlayRequestedTrackVm">
                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                  <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Title}" />
                    <TextBlock Classes="secondary" Text="{Binding Artist}"
                               IsVisible="{Binding Artist, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Play" Command="{Binding PlayCommand}"
                          Classes="secondary" Margin="0,0,4,0" />
                  <Button Grid.Column="2" Content="Remove" Command="{Binding RemoveCommand}"
                          Classes="destructive" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <Expander Header="Advanced" HorizontalContentAlignment="Left">
        <StackPanel Spacing="4" Margin="0,4,0,0">
          <TextBlock Classes="secondary" Text="Custom backend address, for testing. Leave empty to use Spectralis." />
          <TextBox Text="{Binding CdnBaseUrl}" Watermark="Default backend" />
        </StackPanel>
      </Expander>

    </StackPanel>
  </ScrollViewer>

</UserControl>
