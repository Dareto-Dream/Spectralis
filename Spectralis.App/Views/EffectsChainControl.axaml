<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectralis.App.ViewModels"
             xmlns:controls="using:Spectralis.App.Controls"
             x:Class="Spectralis.App.Views.EffectsChainControl"
             x:DataType="vm:EffectsChainViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="14" RowSpacing="10">

    <!-- Top bar: master enable + add effect + whole-rack presets -->
    <StackPanel Grid.Row="0" Spacing="6">
      <CheckBox Content="Effects enabled" IsChecked="{Binding ChainEnabled}" />
      <Grid ColumnDefinitions="*,Auto">
        <ComboBox Grid.Column="0"
                  ItemsSource="{Binding AvailableEffects}"
                  SelectedItem="{Binding SelectedNewEffect}"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,6,0" />
        <Button Grid.Column="1" Content="Add" Click="OnAddEffect" Classes="primary" />
      </Grid>
      <Grid ColumnDefinitions="*,Auto">
        <ComboBox Grid.Column="0"
                  ItemsSource="{Binding ChainPresetNames}"
                  SelectedItem="{Binding SelectedChainPresetName}"
                  HorizontalAlignment="Stretch"
                  Margin="0,0,6,0" />
        <Button Grid.Column="1" Content="Load" Click="OnLoadChainPreset" Classes="primary" />
      </Grid>
      <StackPanel Orientation="Horizontal" Spacing="6">
        <TextBox Watermark="Save chain as…" Text="{Binding NewChainPresetName}" Width="150"
                 FontSize="{StaticResource FontSize.UI.Small}" />
        <Button Content="Save" Click="OnSaveChainPreset" FontSize="{StaticResource FontSize.UI.Small}" />
        <Button Content="Delete" Click="OnDeleteChainPreset"
                IsEnabled="{Binding CanDeleteSelectedChainPreset}"
                Classes="destructive" FontSize="{StaticResource FontSize.UI.Small}" />
      </StackPanel>
    </StackPanel>

    <!-- Rack list -->
    <Grid Grid.Row="1" RowDefinitions="Auto,Auto" RowSpacing="6">
      <ListBox Grid.Row="0"
               ItemsSource="{Binding EffectItems}"
               SelectedItem="{Binding SelectedEffect}"
               MaxHeight="140">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:EffectItemViewModel">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <CheckBox IsChecked="{Binding Enabled}" Padding="0" />
              <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6">
        <Button Content="Up" Click="OnMoveUp" FontSize="{StaticResource FontSize.UI.Small}" />
        <Button Content="Down" Click="OnMoveDown" FontSize="{StaticResource FontSize.UI.Small}" />
        <Button Content="Remove" Click="OnRemove" Classes="destructive" FontSize="{StaticResource FontSize.UI.Small}" />
      </StackPanel>
    </Grid>

    <!-- Parameters for the selected effect -->
    <Border Grid.Row="2"
            Background="{StaticResource Brush.Bg.Raised}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1"
            Padding="12">
      <ScrollViewer>
        <StackPanel Spacing="6" DataContext="{Binding SelectedEffect}">
          <TextBlock Classes="heading"
                     FontSize="{StaticResource FontSize.UI}"
                     Text="{Binding Name, FallbackValue='No effect selected'}" />

          <!-- Parametric EQ: envelope curve editor + presets -->
          <StackPanel IsVisible="{Binding HasEqEditor, FallbackValue=false, TargetNullValue=false}" Spacing="6">
            <StackPanel Spacing="6" DataContext="{Binding EqEditor}">
              <Grid ColumnDefinitions="*,Auto">
                <ComboBox Grid.Column="0"
                          ItemsSource="{Binding PresetNames}"
                          SelectedItem="{Binding SelectedPresetName}"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,6,0" />
                <Button Grid.Column="1" Content="Reset" Click="OnEqReset"
                        FontSize="{StaticResource FontSize.UI.Small}" />
              </Grid>

              <controls:EqCurveEditor Editor="{Binding}"
                                      Height="190"
                                      CurveBrush="{StaticResource Brush.Accent}"
                                      GridBrush="{StaticResource Brush.Border}"
                                      TextBrush="{StaticResource Brush.Ink.Secondary}" />

              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Classes="secondary" VerticalAlignment="Center"
                           Text="Preamp" FontSize="{StaticResource FontSize.UI.Small}" />
                <Slider Grid.Column="1" Minimum="-24" Maximum="24"
                        Value="{Binding PreampDb, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Classes="data" VerticalAlignment="Center"
                           Text="{Binding PreampDb, StringFormat={}{0:0.0} dB}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Classes="secondary" VerticalAlignment="Center"
                           Text="Output" FontSize="{StaticResource FontSize.UI.Small}" />
                <Slider Grid.Column="1" Minimum="-24" Maximum="24"
                        Value="{Binding OutputGainDb, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Classes="data" VerticalAlignment="Center"
                           Text="{Binding OutputGainDb, StringFormat={}{0:0.0} dB}" />
              </Grid>

              <StackPanel Orientation="Horizontal" Spacing="6">
                <TextBox Watermark="Preset name" Text="{Binding NewPresetName}" Width="118"
                         FontSize="{StaticResource FontSize.UI.Small}" />
                <Button Content="Save" Click="OnEqSavePreset"
                        FontSize="{StaticResource FontSize.UI.Small}" />
                <Button Content="Delete" Click="OnEqDeletePreset"
                        IsEnabled="{Binding CanDeleteSelectedPreset}"
                        Classes="destructive" FontSize="{StaticResource FontSize.UI.Small}" />
              </StackPanel>
            </StackPanel>

            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       FontSize="{StaticResource FontSize.UI.Small}"
                       Text="Drag nodes to shape the curve · scroll a node for Q · double-click to add or remove · right-click for filter type. Applies to local files and downloaded URL sources (SoundCloud, YouTube…). For Spotify, enable EQ in Settings → Playback." />
          </StackPanel>

          <!-- Stereo Panner: bar-based auto-pan loop editor -->
          <StackPanel IsVisible="{Binding HasPanEditor, FallbackValue=false, TargetNullValue=false}" Spacing="6" Margin="0,8,0,0">
            <StackPanel Spacing="6" DataContext="{Binding PanEditor}">
              <Grid ColumnDefinitions="Auto,*,Auto">
                <CheckBox Grid.Column="0" Content="Auto-pan loop" IsChecked="{Binding AutoPanEnabled}" />
                <Button Grid.Column="2" Content="Reset" Click="OnPanReset"
                        FontSize="{StaticResource FontSize.UI.Small}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Classes="secondary" VerticalAlignment="Center"
                           Text="Bars" FontSize="{StaticResource FontSize.UI.Small}" />
                <Slider Grid.Column="1" Minimum="1" Maximum="16" Value="{Binding Bars, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Classes="data" VerticalAlignment="Center" Text="{Binding Bars}" />
              </Grid>
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Classes="secondary" VerticalAlignment="Center"
                           Text="BPM" FontSize="{StaticResource FontSize.UI.Small}" />
                <Slider Grid.Column="1" Minimum="40" Maximum="220" Value="{Binding Bpm, Mode=TwoWay}" />
                <TextBlock Grid.Column="2" Classes="data" VerticalAlignment="Center"
                           Text="{Binding Bpm, StringFormat={}{0:0}}" />
              </Grid>
              <controls:PanCurveEditor Editor="{Binding}"
                                      Height="140"
                                      CurveBrush="{StaticResource Brush.Accent}"
                                      GridBrush="{StaticResource Brush.Border}"
                                      TextBrush="{StaticResource Brush.Ink.Secondary}" />
            </StackPanel>

            <TextBlock Classes="secondary" TextWrapping="Wrap"
                       FontSize="{StaticResource FontSize.UI.Small}"
                       Text="When Auto-pan loop is on, the pan position follows this curve instead of the static Pan slider above, looping every N bars at the given BPM. Drag nodes to shape it · double-click to add or remove. The loop restarts at track start/seek — it isn't locked to the track's actual beat grid." />
          </StackPanel>

          <!-- Other effects: parameter sliders -->
          <ItemsControl IsVisible="{Binding !HasEqEditor}" ItemsSource="{Binding Sliders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:EffectParamViewModel">
                <StackPanel Margin="0,4,0,0" Spacing="2">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0"
                               Classes="secondary"
                               Text="{Binding Label}"
                               FontSize="{StaticResource FontSize.UI.Small}" />
                    <TextBlock Grid.Column="1"
                               Classes="data"
                               Text="{Binding ValueText}"
                               TextAlignment="Right" />
                  </Grid>
                  <Slider Minimum="{Binding Minimum}"
                          Maximum="{Binding Maximum}"
                          Value="{Binding Value, Mode=TwoWay}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>
</UserControl>
