<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Spectralis.App.Views.SongWarsWindow"
        Title="Song Wars"
        Width="1020" Height="720"
        MinWidth="860" MinHeight="580"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        ShowInTaskbar="True"
        Background="{StaticResource Brush.Bg.Base}"
        KeyDown="OnKeyDown">

  <!-- Thin floating shell: owns no state of its own. The live SongWarsView's
       MainContentGrid is relocated into Host for the duration of the pop-out
       (see MainWindow.axaml.cs OpenOrFocusSongWars). -->
  <Grid RowDefinitions="36,*">

    <!-- ── Custom title bar ── -->
    <Border Grid.Row="0"
            Background="{StaticResource Brush.Bg.Overlay}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="Song Wars"
                   Classes="secondary"
                   FontSize="{StaticResource FontSize.UI.Small}"
                   VerticalAlignment="Center"
                   Margin="14,0" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
          <Button Content="—" Classes="ghost" Width="36" Height="36" Padding="0"
                  Click="OnMinimize" ToolTip.Tip="Minimize" />
          <Button Content="⊡" Classes="ghost" Width="36" Height="36" Padding="0"
                  Click="OnDock" ToolTip.Tip="Dock to Now Playing sidebar" />
          <Button Content="✕" Classes="ghost" Width="36" Height="36" Padding="0"
                  Click="OnClose" ToolTip.Tip="Dock back to the sidebar page" />
        </StackPanel>
      </Grid>
    </Border>

    <Panel Grid.Row="1" x:Name="Host" />

  </Grid>
</Window>
