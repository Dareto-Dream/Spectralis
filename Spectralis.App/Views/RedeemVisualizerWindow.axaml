<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Spectralis.App.Views.RedeemVisualizerWindow"
        Title="Manage Visualizers"
        Width="520" SizeToContent="Height"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        CanResize="False"
        SystemDecorations="BorderOnly"
        KeyDown="OnKeyDown"
        Background="{StaticResource Brush.Bg.Base}">

  <Grid RowDefinitions="36,*">

    <!-- ── Custom title bar ── -->
    <Border Grid.Row="0"
            Background="{StaticResource Brush.Bg.Overlay}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="0,0,0,1"
            PointerPressed="OnTitleBarPointerPressed">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
                   Text="Manage Visualizers"
                   Classes="secondary"
                   FontSize="{StaticResource FontSize.UI.Small}"
                   VerticalAlignment="Center"
                   Margin="14,0" />
        <Button Grid.Column="1" Content="✕" Classes="ghost" Width="36" Height="36" Padding="0"
                Click="OnClose" />
      </Grid>
    </Border>

    <StackPanel Grid.Row="1" Margin="28,20,28,24" Spacing="16">

      <TextBlock Classes="secondary"
                 TextWrapping="Wrap"
                 Text="Enter your redeem key to download and install a Spectralis visualizer from the DeltaVDevs CDN." />

      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
        <TextBox Grid.Column="0"
                 x:Name="RedeemKeyBox"
                 Watermark="Redeem key"
                 MaxLength="64"
                 KeyDown="OnRedeemKeyBoxKeyDown" />
        <Button Grid.Column="1"
                x:Name="RedeemButton"
                Content="Redeem"
                Click="OnRedeem"
                Classes="primary"
                MinWidth="90" />
      </Grid>

      <TextBlock x:Name="StatusLabel"
                 TextWrapping="Wrap"
                 Classes="secondary"
                 IsVisible="False" />

      <Border x:Name="InstalledPanel"
              Classes="card"
              Padding="12,8"
              IsVisible="False">
        <StackPanel Spacing="8">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       x:Name="InstalledCountLabel"
                       Classes="secondary"
                       FontSize="{StaticResource FontSize.UI.Small}"
                       VerticalAlignment="Center" />
            <Button Grid.Column="1"
                    Content="Clear all"
                    Click="OnClearAll"
                    Classes="destructive"
                    FontSize="{StaticResource FontSize.UI.Small}" />
          </Grid>
          <ScrollViewer MaxHeight="130">
            <ItemsControl x:Name="InstalledList" />
          </ScrollViewer>
        </StackPanel>
      </Border>

      <Grid ColumnDefinitions="*,Auto">
        <Button Grid.Column="0"
                Content="Open Scripted Visualizers Editor…"
                Click="OnOpenScriptedVisualizers"
                HorizontalAlignment="Left" />
        <Button Grid.Column="1"
                Content="Close"
                Classes="ghost"
                Click="OnClose" />
      </Grid>

    </StackPanel>
  </Grid>
</Window>
