<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Spectralis.App.Views.WasmWorldTestWindow"
        Title="3D World Test Rig — Spectralis"
        Icon="/Assets/icon.png"
        Width="820" Height="620"
        Background="#0a0a0a">

  <Grid RowDefinitions="*,Auto" Margin="12">
    <Border Grid.Row="0"
            Background="#111111"
            BorderBrush="#2a2a2a"
            BorderThickness="1"
            CornerRadius="4"
            ClipToBounds="True">
      <Grid>
        <Image x:Name="Surface"
               Stretch="Uniform"
               PointerPressed="OnSurfacePointerPressed"
               PointerMoved="OnSurfacePointerMoved"
               PointerReleased="OnSurfacePointerReleased" />
        <TextBlock x:Name="UnavailableLabel"
                   Text="wgpu-host native renderer unavailable on this machine (no compatible GPU, or the library wasn't built)."
                   Foreground="#8cffffff"
                   FontFamily="Segoe UI, Arial"
                   FontSize="13"
                   TextWrapping="Wrap"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Margin="24"
                   IsVisible="False" />
      </Grid>
    </Border>

    <Border Grid.Row="1"
            Background="#111111"
            BorderBrush="#2a2a2a"
            BorderThickness="1"
            CornerRadius="4"
            Margin="0,10,0,0"
            Padding="10">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Grid.Row="0" Grid.Column="0"
                   Text="Drag the render surface to orbit the camera. Events fired by the sandboxed Wasm test world's on_load show up below."
                   Foreground="#8cffffff"
                   FontFamily="Segoe UI, Arial"
                   FontSize="11"
                   TextWrapping="Wrap" />
        <Button Grid.Row="0" Grid.Column="1"
                Content="Request switch_to_html"
                Click="OnRequestSwitchToHtml"
                Margin="10,0,0,0" />
        <TextBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                 x:Name="EventLog"
                 Margin="0,8,0,0"
                 Height="90"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 FontFamily="Consolas, Cascadia Mono, monospace"
                 FontSize="11"
                 Background="#0a0a0a"
                 Foreground="#b0ffffff"
                 BorderThickness="0" />
      </Grid>
    </Border>
  </Grid>
</Window>
