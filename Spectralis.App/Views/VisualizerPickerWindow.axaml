<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Spectralis.App.ViewModels"
        xmlns:controls="using:Spectralis.App.Controls"
        x:Class="Spectralis.App.Views.VisualizerPickerWindow"
        x:DataType="vm:VisualizerGalleryViewModel"
        Title="Visualizers" Icon="/Assets/icon.png"
        Width="980" Height="720" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Brush.Bg.Base}">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="24" RowSpacing="16">
    <Grid ColumnDefinitions="*,260">
      <TextBlock Text="Visualizers" FontSize="28" FontWeight="SemiBold" />
      <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding Search}" Watermark="Search visualizers"
               AutomationProperties.Name="Search visualizers" VerticalAlignment="Center" />
    </Grid>
    <ListBox Grid.Row="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}"
             Background="Transparent" HorizontalAlignment="Left" AutomationProperties.Name="Visualizer category">
      <ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate></ListBox.ItemsPanel>
    </ListBox>
    <Grid Grid.Row="2">
      <Panel>
        <ListBox x:Name="GalleryList" ItemsSource="{Binding Families}" SelectedItem="{Binding SelectedFamily}"
                 Background="Transparent" AutomationProperties.Name="Visualizer gallery"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
          <ListBox.Styles>
            <Style Selector="ListBoxItem"><Setter Property="Padding" Value="6" /><Setter Property="Margin" Value="0,0,8,10" /></Style>
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="{StaticResource Brush.Bg.Raised}" />
              <Setter Property="BorderBrush" Value="{StaticResource Brush.Signal}" />
              <Setter Property="BorderThickness" Value="1" />
            </Style>
            <Style Selector="ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{StaticResource Brush.Ink.Primary}" /></Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:VisualizerFamily">
              <StackPanel Width="196" Spacing="8">
                <Border Height="110" CornerRadius="4" ClipToBounds="True" Background="{StaticResource Brush.Bg.Raised}">
                  <Panel>
                    <controls:VisualizerThumbnail Mode="{Binding PreviewMode}" Height="110" IsHitTestVisible="False" IsVisible="{Binding !IsCustom}" />
                    <TextBlock Text="Custom visualizer" IsVisible="{Binding IsCustom}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="secondary" />
                  </Panel>
                </Border>
                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" Margin="2,2,0,0" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel IsVisible="{Binding IsEmpty}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8">
          <TextBlock Text="No visualizers found" FontWeight="SemiBold" />
          <TextBlock Text="Try another name or category." Classes="secondary" />
        </StackPanel>
      </Panel>
    </Grid>
    <Grid Grid.Row="3" RowDefinitions="Auto,Auto" RowSpacing="12">
      <ComboBox ItemsSource="{Binding SelectedFamily.Variants}" SelectedItem="{Binding SelectedVariant}" IsVisible="{Binding HasVariations}" MinWidth="200" AutomationProperties.Name="Visualizer variation" />
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
      <Button x:Name="ClearButton" Content="Use app default" Click="OnClear" Classes="ghost" HorizontalAlignment="Left" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Cancel" Click="OnCancel" IsCancel="True" />
        <Button x:Name="ApplyButton" Content="Use visualizer" Click="OnSet" IsDefault="True" Classes="primary" IsEnabled="{Binding !IsEmpty}" />
      </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
