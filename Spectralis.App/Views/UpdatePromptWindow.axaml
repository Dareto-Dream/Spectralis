<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Spectralis.App.Views.UpdatePromptWindow"
        Title="Spectralis Update"
        SystemDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        KeyDown="OnKeyDown">

  <!-- Sized/positioned in code-behind to exactly cover the owner window, so the
       scrim below actually dims everything behind it instead of the dialog
       floating a fixed 480x200 box that leaves owner content exposed around it
       (that gap is what used to let the empty-state CTAs bleed through). -->
  <Grid>
    <Border Background="#B0000000" />

    <Border HorizontalAlignment="Center" VerticalAlignment="Center"
            Width="480" MinHeight="200"
            Background="{StaticResource Brush.Bg.Base}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1">
      <Grid RowDefinitions="*,Auto" Margin="28,22,28,20">

        <StackPanel Grid.Row="0" Spacing="10">
          <TextBlock Classes="heading" Text="A Spectralis update is available" />
          <TextBlock x:Name="MessageLabel" Classes="secondary" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
          <Button Classes="ghost" Content="Don't remind again" Click="OnDontRemind" />
          <Button Classes="ghost" Content="Remind later"       Click="OnRemindLater" />
          <Button             Content="Update now"             Click="OnUpdateNow"   Classes="primary" />
        </StackPanel>

      </Grid>
    </Border>
  </Grid>
</Window>
