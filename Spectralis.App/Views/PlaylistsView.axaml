<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectralis.App.ViewModels"
             xmlns:design="using:Spectralis.App.Design"
             x:Class="Spectralis.App.Views.PlaylistsView"
             x:DataType="vm:PlaylistsViewModel">

  <Panel>

    <!-- ============ Empty state ============ -->
    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440"
                IsVisible="{Binding !HasPlaylists}">
      <PathIcon Data="{x:Static design:IconData.Playlists}"
                Width="48" Height="48"
                Foreground="{StaticResource Brush.Ink.Muted}"
                HorizontalAlignment="Center"
                Opacity="0.6"
                Margin="0,0,0,16" />
      <TextBlock Classes="display" Text="No playlists yet"
                 TextAlignment="Center" Margin="0,0,0,8" />
      <TextBlock Classes="muted"
                 Text="Create a static playlist, build a smart playlist from rules, import an M3U, or link Spotify in Settings to pull yours in."
                 TextAlignment="Center"
                 FontSize="{StaticResource FontSize.UI.Small}"
                 TextWrapping="Wrap"
                 Margin="0,0,0,20" />
      <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
        <Button Content="New Playlist…" Click="OnNewPlaylist" Classes="primary" />
        <Button Content="New Smart…" Click="OnNewSmart" />
        <Button Content="Import M3U…" Click="OnImportM3u" />
      </StackPanel>
    </StackPanel>

    <!-- ============ Playlist grid ============ -->
    <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding HasPlaylists}">

      <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8" Margin="16,12">
        <Button Content="New Playlist..." Click="OnNewPlaylist" />
        <Button Content="New Smart..." Click="OnNewSmart" />
        <Button Content="Import M3U..." Click="OnImportM3u" />
      </StackPanel>

      <ScrollViewer Grid.Row="1" Margin="16,0">
        <ListBox x:Name="PlaylistGrid"
                 ItemsSource="{Binding Rows}"
                 SelectedItem="{Binding SelectedRow}"
                 DoubleTapped="OnRowDoubleTapped">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="vm:PlaylistRow">
              <StackPanel Width="160" Spacing="6" Margin="4,4,4,12">

                <!-- Cover: art if resolved, else the placeholder glyph. Runtime badge sits
                     bottom-right over the art, matching the app's monospace data-readout style. -->
                <Panel Width="160" Height="160">
                  <Border Background="{StaticResource Brush.Bg.Base}"
                          BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1">
                    <Grid>
                      <Image Source="{Binding CoverBitmap}" Stretch="UniformToFill"
                             IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNotNull}}" />
                      <PathIcon Data="{x:Static design:IconData.Album}"
                                Width="40" Height="40"
                                Foreground="{StaticResource Brush.Ink.Muted}"
                                Opacity="0.5"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                IsVisible="{Binding CoverBitmap, Converter={x:Static ObjectConverters.IsNull}}" />
                    </Grid>
                  </Border>
                  <Border HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,4,4" Padding="4,2"
                          Background="{StaticResource Brush.Bg.Base}"
                          BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1">
                    <TextBlock Classes="data" Text="{Binding RuntimeText}" FontSize="{StaticResource FontSize.UI.Small}" />
                  </Border>
                  <Border HorizontalAlignment="Left" VerticalAlignment="Top"
                          Margin="4,4,0,0" Padding="4,1"
                          Background="{StaticResource Brush.Bg.Base}"
                          BorderBrush="{StaticResource Brush.Border}"
                          BorderThickness="1"
                          IsVisible="{Binding IsSpotify}">
                    <TextBlock Text="Spotify" Classes="muted" FontSize="{StaticResource FontSize.UI.Small}" />
                  </Border>
                </Panel>

                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" MaxLines="1" />
                <TextBlock Classes="muted" Text="{Binding TrackCountText}" FontSize="{StaticResource FontSize.UI.Small}" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
          <ListBox.ContextMenu>
            <ContextMenu>
              <MenuItem Header="Play" Click="OnPlay" />
              <MenuItem Header="Edit..." Click="OnEdit" />
              <MenuItem Header="Rename Locally..." Click="OnRenameLocally" />
              <MenuItem Header="Set Cover Image..." Click="OnSetCoverImage" />
              <MenuItem Header="Set Default Visualizer..." Click="OnSetDefaultVisualizer" />
              <Separator />
              <MenuItem Header="Move Left" Click="OnMoveUp" />
              <MenuItem Header="Move Right" Click="OnMoveDown" />
              <Separator />
              <MenuItem Header="Export M3U..." Click="OnExportM3u" />
              <Separator />
              <MenuItem Header="Delete" Click="OnDelete" />
            </ContextMenu>
          </ListBox.ContextMenu>
        </ListBox>
      </ScrollViewer>

      <TextBlock Grid.Row="2" Classes="muted"
                 Text="{Binding StatusText}"
                 Margin="16,8"
                 FontSize="{StaticResource FontSize.UI.Small}" />
    </Grid>
  </Panel>
</UserControl>
