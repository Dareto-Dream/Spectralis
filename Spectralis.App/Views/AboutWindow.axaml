<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Spectralis.App.Views.AboutWindow"
        Title="About Spectralis"
        Icon="/Assets/icon.png"
        WindowStartupLocation="CenterOwner"
        Width="560" Height="520"
        MinWidth="460" MinHeight="380"
        Background="{StaticResource Brush.Bg.Base}">

  <Grid RowDefinitions="Auto,*,Auto" Margin="24" RowSpacing="16">
    <StackPanel Grid.Row="0" Spacing="6">
      <StackPanel Orientation="Horizontal" Spacing="12">
        <Image Source="/Assets/icon.png"
               Width="96" Height="96"
               Stretch="Uniform" />
        <TextBlock Classes="display" Text="Spectralis" VerticalAlignment="Center" />
      </StackPanel>
      <TextBlock Classes="secondary" Text="Audio playback, visualizers, shared listening, and creator capsules." />
    </StackPanel>

    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="14">
        <TextBlock Classes="secondary"
                   TextWrapping="Wrap"
                   Text="Spectralis is a music player built on the idea that a song can be a place, not just a sound. Normal files play instantly and stay that way — every richer layer is additive. On top of playback, a track can carry its own visualizers, synced and annotated lyrics, reactive timelines, and signed capsule releases, and the whole experience can travel through Shared Play rooms, Discord Rich Presence, and a live OBS overlay." />

        <TextBlock Classes="secondary"
                   TextWrapping="Wrap"
                   Text="Made by DeltaVortex under DeltaVDevs. Built with AvaloniaUI on .NET. Releases, documentation, and contact live at deltavdevs.com." />

        <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0" />

        <TextBlock x:Name="DetailsText"
                   Classes="data"
                   TextWrapping="Wrap" />
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
      <Button Content="Copy Version" Click="OnCopyVersion" />
      <Button Content="Visit DeltaVDevs" Click="OnVisitWebsite" />
      <Button Content="Close" Click="OnClose" />
    </StackPanel>
  </Grid>
</Window>
