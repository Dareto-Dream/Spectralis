<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectralis.App.ViewModels" xmlns:sw="using:Spectralis.Core.SongWars"
             x:Class="Spectralis.App.Views.SongWarsView" x:DataType="vm:SongWarsViewModel">
  <UserControl.Styles>
    <Style Selector="Expander /template/ ToggleButton"><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
    <Style Selector="Expander /template/ ToggleButton:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Ink.Primary}" />
    </Style>
  </UserControl.Styles>
  <Grid x:Name="ContentHost">
    <Grid x:Name="MainContentGrid">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="Song Wars" FontSize="20" FontWeight="SemiBold" />
          <Button Grid.Column="1" Content="Pop out" Click="OnPopOutClick" Classes="ghost" />
        </Grid>
        <Expander Header="Set up a tournament" IsVisible="{Binding !HasTournament}" HorizontalAlignment="Stretch">
        <StackPanel Spacing="10">
          <TextBlock Text="Build a tournament from requests or local tracks." Classes="secondary" TextWrapping="Wrap" />
          <TextBox Text="{Binding Name}" Watermark="Tournament name" AutomationProperties.Name="Tournament name" />
          <TextBox Text="{Binding JudgeNames}" Watermark="Judge names, separated by commas" AutomationProperties.Name="Judge names" />
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding Entries.Count, StringFormat='{}{0} entries'}" VerticalAlignment="Center" Classes="secondary" />
            <Button Grid.Column="1" Content="Add audio files" Click="OnAddFiles" />
          </Grid>
          <ScrollViewer MaxHeight="220" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Entries}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="sw:SongWarsSubmission">
                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                  <TextBlock Text="{Binding DisplayTitle}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                  <Button Grid.Column="1" Content="Remove" Click="OnRemoveEntry" Classes="ghost" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          </ScrollViewer>
          <Button Content="Create tournament" Command="{Binding CreateCommand}" Classes="accent" HorizontalAlignment="Left" />
          <Expander Header="Saved tournaments" HorizontalAlignment="Stretch">
            <StackPanel Spacing="8">
              <ComboBox ItemsSource="{Binding SavedTournaments}" SelectedItem="{Binding SavedId}" HorizontalAlignment="Stretch" PlaceholderText="Choose a tournament" />
              <Button Content="Continue tournament" Command="{Binding LoadCommand}" HorizontalAlignment="Left" />
            </StackPanel>
          </Expander>
        </StackPanel>
        </Expander>
        <StackPanel Spacing="12" IsVisible="{Binding HasTournament}">
          <TextBlock Text="{Binding TournamentName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Round}" Classes="secondary" />
          <Grid ColumnDefinitions="*,16,*">
            <StackPanel Spacing="8">
              <TextBlock Text="{Binding TrackA}" FontSize="18" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ArtistA}" IsVisible="{Binding ArtistA, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="secondary" TextWrapping="Wrap" />
              <Button Content="Play A" Command="{Binding PlayACommand}" IsEnabled="{Binding CanPlayA}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="8">
              <TextBlock Text="{Binding TrackB}" FontSize="18" TextWrapping="Wrap" />
              <TextBlock Text="{Binding ArtistB}" IsVisible="{Binding ArtistB, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Classes="secondary" TextWrapping="Wrap" />
              <Button Content="Play B" Command="{Binding PlayBCommand}" IsEnabled="{Binding CanPlayB}" />
            </StackPanel>
          </Grid>
          <TextBlock Text="{Binding Phase}" Foreground="{DynamicResource Brush.Signal}" />
          <WrapPanel>
            <Button Content="Open voting" Command="{Binding VoteCommand}" IsEnabled="{Binding CanOpenVoting}" Margin="0,0,8,8" />
            <Button Content="Reveal result" Command="{Binding RevealCommand}" IsEnabled="{Binding CanVote}" Classes="accent" Margin="0,0,8,8" />
            <Button Content="Skip match" Command="{Binding SkipCommand}" Margin="0,0,8,8" />
          </WrapPanel>
          <StackPanel IsVisible="{Binding CanVote}" Spacing="8">
            <ItemsControl ItemsSource="{Binding Judges}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:SongWarsJudgeViewModel">
                  <StackPanel Spacing="6" Margin="0,0,0,12">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                    <WrapPanel>
                      <Button Content="A wins" Command="{Binding VoteACommand}" Margin="0,0,6,4" />
                      <Button Content="B wins" Command="{Binding VoteBCommand}" Margin="0,0,6,4" />
                      <Button Content="Eliminate A" Command="{Binding EliminateACommand}" Classes="ghost" Margin="0,0,6,4" />
                      <Button Content="Eliminate B" Command="{Binding EliminateBCommand}" Classes="ghost" Margin="0,0,6,4" />
                    </WrapPanel>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{Binding Tally}" Classes="secondary" />
            <Button Content="Open elimination vote" Command="{Binding EliminationCommand}" IsEnabled="{Binding CanEliminate}" HorizontalAlignment="Left" />
          </StackPanel>
          <WrapPanel>
            <Button Content="Pause round" Command="{Binding PauseCommand}" IsVisible="{Binding !IsPaused}" Margin="0,0,8,0" />
            <Button Content="Resume round" Command="{Binding ResumeCommand}" IsVisible="{Binding IsPaused}" Margin="0,0,8,0" />
            <Button Content="Return to listening" Command="{Binding ReturnToQueueCommand}" Classes="ghost" Margin="0,0,8,0" />
            <Button Content="Save and close" Command="{Binding CloseCommand}" Classes="ghost" />
          </WrapPanel>
          <Expander Header="Results" HorizontalAlignment="Stretch">
            <ItemsControl ItemsSource="{Binding Results}" />
          </Expander>
        </StackPanel>
        <TextBlock Text="{Binding Status}" IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" Classes="secondary" />
      </StackPanel>
    </Grid>
    <StackPanel x:Name="PoppedOutPlaceholder" IsVisible="False" Spacing="8">
      <TextBlock Text="Song Wars is open in another window." Classes="secondary" />
      <Button Content="Bring to front" Click="OnPopOutClick" HorizontalAlignment="Left" />
    </StackPanel>
  </Grid>
</UserControl>
