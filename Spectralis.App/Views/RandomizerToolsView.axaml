<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Spectralis.App.ViewModels"
             xmlns:conv="using:Spectralis.App.Converters"
             x:Class="Spectralis.App.Views.RandomizerToolsView"
             x:DataType="vm:RandomizerToolsViewModel">

  <Grid RowDefinitions="Auto,*">

    <!-- Header -->
    <Border Grid.Row="0" Background="{StaticResource Brush.Bg.Raised}" Padding="24,14">
      <StackPanel Spacing="2">
        <TextBlock Classes="heading" Text="Randomizer Tools" />
        <TextBlock Classes="secondary" Text="Stream tools: coin flip, and a wheel of text, songs, or playlists" />
      </StackPanel>
    </Border>

    <!-- Body -->
    <Grid Grid.Row="1" ColumnDefinitions="*,Auto">

      <!-- Wheel area fills all available space -->
      <Grid Grid.Column="0" RowDefinitions="*,Auto">
        <Canvas Name="WheelCanvas" Grid.Row="0"
                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" Spacing="8" Margin="0,12,0,20">
          <TextBlock Text="{Binding WheelResult}"
                     HorizontalAlignment="Center"
                     FontSize="18" FontWeight="SemiBold"
                     IsVisible="{Binding HasWheelResult}" />
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
            <Button Content="{Binding SpinButtonText}" Command="{Binding SpinCommand}"
                    Classes="primary" />
            <Button Content="{Binding PlayResultText}" Command="{Binding PlayResultCommand}"
                    IsVisible="{Binding CanPlayResult}"
                    ToolTip.Tip="Send what the wheel landed on to Now Playing" />
          </StackPanel>
        </StackPanel>
      </Grid>

      <!-- Sidebar: coin toss + entries -->
      <Border Grid.Column="1" Width="300"
              Background="{StaticResource Brush.Bg.Raised}"
              BorderBrush="{StaticResource Brush.Border}" BorderThickness="1,0,0,0"
              Padding="16">
        <Grid RowDefinitions="Auto,Auto,Auto,*">

          <!-- Coin toss -->
          <TextBlock Grid.Row="0" Classes="heading" Text="Coin Toss" Margin="0,0,0,12" />
          <StackPanel Grid.Row="1" Spacing="10" HorizontalAlignment="Center" Margin="0,0,0,16">
            <Border Name="CoinVisual" Width="80" Height="80" CornerRadius="40"
                    Background="{StaticResource Brush.Signal}" HorizontalAlignment="Center">
              <TextBlock Name="CoinFaceLabel" Text="?"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         FontSize="24" FontWeight="Bold"
                         Foreground="{StaticResource Brush.Bg.Base}" />
            </Border>
            <TextBlock Text="{Binding CoinResult}"
                       HorizontalAlignment="Center"
                       FontSize="14" FontWeight="SemiBold"
                       IsVisible="{Binding CoinResult, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Content="Flip Coin" Command="{Binding FlipCoinCommand}"
                    Classes="primary" HorizontalAlignment="Center" />
          </StackPanel>

          <Separator Grid.Row="2" Margin="0,0,0,12" />

          <ScrollViewer Grid.Row="3">
            <StackPanel Spacing="10">

              <!-- Wheel mode -->
              <TextBlock Classes="secondary" Text="WHEEL CONTENTS" FontWeight="SemiBold" />
              <ComboBox ItemsSource="{Binding Modes}"
                        SelectedItem="{Binding SelectedModeOption}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:RandomizerModeOption">
                    <TextBlock Text="{Binding Label}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>

              <!-- ===== Text mode: free-text notepad ===== -->
              <StackPanel Spacing="10" IsVisible="{Binding IsTextMode}">
                <TextBlock Classes="secondary" FontStyle="Italic" FontSize="11"
                           Text="One entry per line." TextWrapping="Wrap" />
                <TextBox Text="{Binding NotepadText, Mode=TwoWay}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         Height="120"
                         VerticalContentAlignment="Top"
                         Watermark="Option 1&#10;Option 2&#10;Option 3" />
              </StackPanel>

              <!-- ===== Song mode: library / Spotify picker ===== -->
              <StackPanel Spacing="8" IsVisible="{Binding IsSongMode}">
                <TextBox Text="{Binding MusicSearchText, Mode=TwoWay}"
                         Watermark="Search your library or Spotify..." />
                <Button Content="Add everything in the queue"
                        Command="{Binding AddCurrentQueueCommand}"
                        Classes="ghost" HorizontalAlignment="Stretch" />

                <TextBlock Classes="secondary" Text="LOAD A PLAYLIST'S SONGS" FontWeight="SemiBold" FontSize="11" />
                <ItemsControl ItemsSource="{Binding PlaylistCandidates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MusicPickCandidate">
                      <Button Classes="ghost" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left"
                              Padding="6,3" Margin="0,1"
                              Click="OnLoadPlaylistSongsClick"
                              ToolTip.Tip="Add every track in this playlist as its own slice">
                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                      </Button>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Classes="secondary" Text="SEARCH RESULTS" FontWeight="SemiBold" FontSize="11" />
                <ItemsControl ItemsSource="{Binding MusicResults}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MusicPickCandidate">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Subtitle}" Classes="secondary" FontSize="11"
                                     TextTrimming="CharacterEllipsis"
                                     IsVisible="{Binding HasSubtitle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Add" Classes="ghost"
                                Padding="8,2" Click="OnAddCandidateClick" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <!-- ===== Playlist mode: pick whole playlists ===== -->
              <StackPanel Spacing="8" IsVisible="{Binding IsPlaylistMode}">
                <TextBlock Classes="secondary" FontStyle="Italic" FontSize="11"
                           Text="Add playlists as slices — the spin picks one to play." TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding PlaylistCandidates}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:MusicPickCandidate">
                      <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Text="{Binding Subtitle}" Classes="secondary" FontSize="11"
                                     IsVisible="{Binding HasSubtitle}" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Add" Classes="ghost"
                                Padding="8,2" Click="OnAddCandidateClick" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <Separator Margin="0,4" />

              <!-- Entries currently on the wheel -->
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="secondary" Text="{Binding EntriesHeader}" FontWeight="SemiBold" />
                <Button Grid.Column="1" Content="Clear" Classes="ghost" Padding="6,1" FontSize="11"
                        Click="OnClearEntriesClick" />
              </Grid>
              <ItemsControl ItemsSource="{Binding WheelEntries}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:WheelEntry">
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,3">
                      <Border Grid.Column="0" Width="10" Height="10" CornerRadius="5"
                              Background="{Binding ColorHex, Converter={x:Static conv:HexColorToBrushConverter.Instance}}"
                              VerticalAlignment="Center" Margin="0,0,8,0" />
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding Subtitle}" Classes="secondary" FontSize="11"
                                   TextTrimming="CharacterEllipsis"
                                   IsVisible="{Binding HasSubtitle}" />
                      </StackPanel>
                      <Button Grid.Column="2" Content="⚙" Classes="ghost"
                              Padding="6,2" FontSize="12"
                              ToolTip.Tip="Entry settings (color, font, weight)">
                        <Button.Flyout>
                          <Flyout Placement="Left">
                            <StackPanel Spacing="8" Width="200" Margin="4">
                              <TextBlock Classes="secondary" Text="Color (hex, blank = default)" />
                              <TextBox Text="{Binding ColorHex}" Watermark="#3B82F6" />
                              <TextBlock Classes="secondary" Text="Font (blank = default)" />
                              <TextBox Text="{Binding FontFamily}" Watermark="Inter" />
                              <TextBlock Classes="secondary" Text="Weight (spin odds / slice size)" />
                              <NumericUpDown Value="{Binding Weight}"
                                             Minimum="0.1" Maximum="100"
                                             Increment="0.5" FormatString="0.#" />
                            </StackPanel>
                          </Flyout>
                        </Button.Flyout>
                      </Button>
                      <Button Grid.Column="3" Content="×" Classes="ghost"
                              Padding="6,2" FontSize="12"
                              Click="OnRemoveEntryClick"
                              ToolTip.Tip="Remove from wheel" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <Separator Margin="0,4" />

              <!-- Saved wheels -->
              <TextBlock Classes="secondary" Text="SAVED WHEELS" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,Auto">
                <TextBox Grid.Column="0" Text="{Binding NewWheelName}"
                         Watermark="Wheel name..." Margin="0,0,6,0" />
                <Button Grid.Column="1" Content="Save" Command="{Binding SaveWheelCommand}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding SavedWheels}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SavedWheel">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding Name}"
                                 VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" />
                      <Button Grid.Column="1" Content="Load" Classes="ghost"
                              Click="OnLoadWheelClick" ToolTip.Tip="Load this wheel" />
                      <Button Grid.Column="2" Content="×" Classes="ghost"
                              Click="OnDeleteWheelClick" ToolTip.Tip="Delete this wheel" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

            </StackPanel>
          </ScrollViewer>

        </Grid>
      </Border>

    </Grid>
  </Grid>

</UserControl>
