<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Spectralis.App.Views.VideoExportWindow"
        Title="Export Video"
        Width="560" Height="660"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="BorderOnly"
        Background="{StaticResource Brush.Bg.Base}"
        KeyDown="OnKeyDown">

  <Grid RowDefinitions="Auto,*,Auto" Margin="28,24,28,20">

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,18">
      <TextBlock Text="Export Video" Classes="heading" />
      <TextBlock x:Name="TrackLabel"
                 Classes="secondary"
                 FontSize="{StaticResource FontSize.UI.Small}"
                 TextTrimming="CharacterEllipsis" />
    </StackPanel>

    <!-- Body -->
    <ScrollViewer Grid.Row="1">
      <StackPanel Spacing="16">

        <!-- Output path -->
        <StackPanel Spacing="6">
          <TextBlock Text="Output File" Classes="secondary" FontSize="{StaticResource FontSize.UI.Small}" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox x:Name="OutputPathBox" Grid.Column="0" Watermark="Choose output file…" IsReadOnly="True" />
            <Button Grid.Column="1" Content="Browse…" Click="OnBrowse" />
          </Grid>
        </StackPanel>

        <!-- Format -->
        <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
          <StackPanel Grid.Column="0" Spacing="6">
            <TextBlock Text="Resolution" Classes="secondary" FontSize="{StaticResource FontSize.UI.Small}" />
            <ComboBox x:Name="ResolutionBox" HorizontalAlignment="Stretch" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="6">
            <TextBlock Text="Frame Rate" Classes="secondary" FontSize="{StaticResource FontSize.UI.Small}" />
            <ComboBox x:Name="FpsBox" HorizontalAlignment="Stretch" />
          </StackPanel>
        </Grid>

        <StackPanel Spacing="6">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Text="Quality" Classes="secondary" FontSize="{StaticResource FontSize.UI.Small}" />
            <TextBlock Grid.Column="1" x:Name="QualityValueLabel" Classes="muted" FontSize="{StaticResource FontSize.UI.Small}" />
          </Grid>
          <Slider x:Name="QualitySlider" Minimum="0" Maximum="100" Value="85" TickFrequency="5" />
        </StackPanel>

        <!-- Visualizer -->
        <StackPanel Spacing="6">
          <TextBlock Text="Visualizer" Classes="secondary" FontSize="{StaticResource FontSize.UI.Small}" />
          <Border BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4">
            <ListBox x:Name="VisualizerList" Height="150" SelectionMode="Single" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:CompileBindings="False">
                  <TextBlock Text="{Binding Label}" IsEnabled="{Binding IsEnabled}" />
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
          </Border>
          <CheckBox x:Name="AutoCycleCheck" Content="Auto-cycle through the selected visualizers"
                    IsCheckedChanged="OnAutoCycleChanged" />
          <StackPanel x:Name="CyclePanel" Orientation="Horizontal" Spacing="8" IsVisible="False">
            <TextBlock Text="Switch every" Classes="secondary" VerticalAlignment="Center"
                       FontSize="{StaticResource FontSize.UI.Small}" />
            <ComboBox x:Name="CycleSecondsBox" Width="90" />
          </StackPanel>
        </StackPanel>

        <!-- Overlays -->
        <StackPanel Spacing="6">
          <TextBlock Text="Overlay" Classes="secondary" FontSize="{StaticResource FontSize.UI.Small}" />
          <WrapPanel>
            <CheckBox x:Name="ShowTitleCheck" Content="Song name" IsChecked="True" Margin="0,0,18,4" />
            <CheckBox x:Name="ShowArtistCheck" Content="Artist" IsChecked="True" Margin="0,0,18,4" />
            <CheckBox x:Name="ShowAlbumCheck" Content="Album" Margin="0,0,18,4" />
            <CheckBox x:Name="ShowAlbumArtCheck" Content="Album cover" IsChecked="True" Margin="0,0,18,4" />
            <CheckBox x:Name="ShowProgressBarCheck" Content="Progress bar" IsChecked="True" Margin="0,0,18,4" />
          </WrapPanel>
        </StackPanel>

        <!-- Progress -->
        <StackPanel Spacing="8">
          <ProgressBar x:Name="ExportProgress" Minimum="0" Maximum="100" Height="5" IsVisible="False" />
          <TextBlock x:Name="StatusLabel"
                     Classes="secondary"
                     FontSize="{StaticResource FontSize.UI.Small}"
                     TextWrapping="Wrap"
                     IsVisible="False" />
        </StackPanel>

      </StackPanel>
    </ScrollViewer>

    <!-- Buttons -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8" Margin="0,16,0,0">
      <TextBlock Grid.Column="0"
                 x:Name="FfmpegHintLabel"
                 Classes="muted"
                 FontSize="{StaticResource FontSize.UI.Small}"
                 Text="Requires FFmpeg in the app folder or PATH."
                 VerticalAlignment="Center"
                 TextWrapping="Wrap" />
      <Button Grid.Column="1" x:Name="ExportButton" Content="Export" Click="OnExport" Classes="primary" />
      <Button Grid.Column="2" x:Name="CloseButton" Classes="ghost" Content="Close" Click="OnClose" />
    </Grid>

  </Grid>
</Window>
